FROM eclipse-temurin:17-jdk AS build

# Set working directory
WORKDIR /app

# Copy and extract the tar file
COPY target/docker/inventorymanagement-app-1.0.0.tar /app/
RUN tar -xvf inventorymanagement-app-1.0.0.tar

# Find the extracted JAR file (modify based on actual extraction result)
RUN mv $(find . -name "*.jar") app.jar

# Start application
CMD ["java", "-jar", "app.jar"]


